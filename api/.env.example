NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET="replace-with-a-long-development-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-development-refresh-secret"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
WEB_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
